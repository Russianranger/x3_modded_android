# ALSA configuration for X3 inside the app's rootfs.
# Every ALSA client (Wine's winealsa.drv on Route B, SDL2/libasound on Route A) ends at TRASC's
# pcm_trasc ioplug plugin, which streams 48 kHz S16 stereo over a private Unix socket to the
# Android AudioBridge (AudioTrack). Nothing here needs /dev/snd, root or a sound server.
#
# The launcher fills in @PLUGIN@ (absolute path to libasound_module_pcm_trasc.so) and exports:
#   ALSA_CONFIG_PATH=<this file>     TRASC_AUDIO_SOCKET=<session>/audio.sock
# (same contract as backend/client_audio.py in trasc-server-android).

</usr/share/alsa/alsa.conf>

pcm_type.trasc { lib "@PLUGIN@" }
pcm.trasc { type trasc }

# Default device: let 'plug' convert whatever the game opens (22.05/44.1 kHz, mono, U8...)
pcm.!default {
    type plug
    slave { pcm "trasc" format S16_LE rate 48000 channels 2 }
}

# Egosoft's own fix for "Unable to initialize audio" on the Linux X3 games defines pcm.dsp0 and
# ctl.mixer0 (the device names ALSA's OSS emulation uses). Route dsp0 to the bridge as well so the
# native build finds a device whichever name it opens.
pcm.dsp0 {
    type plug
    slave { pcm "trasc" format S16_LE rate 48000 channels 2 }
}

# ctl.mixer0: Egosoft's fix points it at hardware card 0, which does not exist inside PRoot.
# Leave this commented until a log shows the native build failing to open a mixer; then ship the
# small ctl_ext stub described in docs/03-audio.md and enable:
# ctl_type.trasc { lib "@CTL_PLUGIN@" }
# ctl.mixer0 { type trasc }
# ctl.!default { type trasc }
