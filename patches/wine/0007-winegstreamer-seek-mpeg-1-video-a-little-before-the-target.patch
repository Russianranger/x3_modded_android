From: X3 Modded <noreply@github.com>
Subject: [PATCH] winegstreamer: Seek MPEG-1 video a little before the target.

GStreamer's MPEG-PS demuxer seeks by system clock reference and lands up to a second either side
of the target. X3: Albion Prelude keeps every comms face in one MPEG-1 movie and seeks between
them, so it showed the end of the previous face, or skipped the start of the new one. When the
MPEG-1 splitter plays video only, seek 1.5 seconds early (a GOP plus the landing error); samples
keep their times relative to the target, and the MPEG video decoder drops what comes before it
(see the previous patches).
---
diff --git a/dlls/winegstreamer/quartz_parser.c b/dlls/winegstreamer/quartz_parser.c
index a0c99a8..fe279ad 100644
--- a/dlls/winegstreamer/quartz_parser.c
+++ b/dlls/winegstreamer/quartz_parser.c
@@ -1897,11 +1897,15 @@ static ULONG WINAPI GST_Seeking_Release(IMediaSeeking *iface)
     return IPin_Release(&This->pin.pin.IPin_iface);
 }
 
+/* 1.5 seconds: a GOP and the demuxer's landing error. */
+#define MPEG_VIDEO_SEEK_PREROLL 15000000
+
 static HRESULT WINAPI GST_Seeking_SetPositions(IMediaSeeking *iface,
         LONGLONG *current, DWORD current_flags, LONGLONG *stop, DWORD stop_flags)
 {
     struct parser_source *pin = impl_from_IMediaSeeking(iface);
     struct parser *filter = impl_from_strmbase_filter(pin->pin.pin.filter);
+    LONGLONG start;
     int i;
 
     TRACE("pin %p, current %s, current_flags %#lx, stop %s, stop_flags %#lx.\n",
@@ -1943,8 +1947,28 @@ static HRESULT WINAPI GST_Seeking_SetPositions(IMediaSeeking *iface,
 
     SourceSeekingImpl_SetPositions(iface, current, current_flags, stop, stop_flags);
 
+    start = pin->seek.llCurrent;
+    /* GStreamer's MPEG-PS demuxer seeks by system clock reference, so it lands up to a second
+     * either side of the target, and then video starts there: X3: Albion Prelude keeps every
+     * comms face in one movie, and showed the end of the previous face or skipped the start of
+     * the new one. Seek a little earlier instead; samples keep their times relative to the
+     * target, and the MPEG video decoder decodes but drops the frames before it. Only when video
+     * is all that plays: an audio decoder would play what came before the target. */
+    for (i = 0; i < filter->source_count; ++i)
+    {
+        if (filter->sources[i] != pin && filter->sources[i]->pin.pin.peer)
+            break;
+    }
+    if (IsEqualGUID(&filter->filter.clsid, &CLSID_MPEG1Splitter) && i == filter->source_count
+            && IsEqualGUID(&pin->pin.pin.mt.majortype, &MEDIATYPE_Video)
+            && (current_flags & AM_SEEKING_PositioningBitsMask) && start > 0)
+    {
+        start = max(start - MPEG_VIDEO_SEEK_PREROLL, 0);
+        TRACE("Seeking to %s for a target of %s.\n", debugstr_time(start), debugstr_time(pin->seek.llCurrent));
+    }
+
     wg_parser_stream_seek(pin->wg_stream, pin->seek.dRate,
-            pin->seek.llCurrent, pin->seek.llStop, current_flags, stop_flags);
+            start, pin->seek.llStop, current_flags, stop_flags);
 
     if (!(current_flags & AM_SEEKING_NoFlush))
     {
